// MKE A.S. — Kurumsal B2G/B2B/B2C CRM
// Prisma şeması. Tüm parasal modeller çoklu para birimi + TCMB kuru taşır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  SALES
  SUPPORT
  VIEWER
}

enum CompanyType {
  /// Ticari firmadan kamuya
  B2G
  /// Ticari firmadan firmaya
  B2B
  /// Ticari firmadan son kullanıcıya
  B2C
  /// Devletten devlete (hükümetler arası anlaşma)
  G2G
  OTHER
}

// ---------------------------------------------------------------------------
// Kimlik, yetki, denetim
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  companies Company[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(VIEWER)
  departmentId String?
  isActive     Boolean  @default(true)

  phone                     String?
  avatarUrl                 String?
  /// ["yedek@mke.gov.tr", "proje@mke.gov.tr"]
  secondaryEmails           Json?
  /// {"showTasks": true, "showBirthdays": false, "showTenders": true}
  calendarFilterPreferences Json?

  // MFA
  mfaEnabled      Boolean @default(false)
  mfaSecret       String?
  /// Tek kullanımlık yedek kodların bcrypt özetleri
  mfaRecoveryHash Json?

  // Oturum güvenliği: tokenVersion artırıldığında tüm JWT'ler geçersiz olur.
  tokenVersion         Int       @default(0)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  passwordChangedAt    DateTime  @default(now())
  lastLoginAt          DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  ownedCompanies Company[]      @relation("CompanyOwner")
  ownedDeals     Deal[]         @relation("DealOwner")
  assignedTasks  Task[]         @relation("TaskAssignee")
  assignedTickets Ticket[]      @relation("TicketAssignee")
  activities     Activity[]
  notes          Note[]
  emails         EmailQueue[]
  hostedVisits   ProtocolVisit[]      @relation("VisitHost")
  visitRoles     VisitParticipant[]   @relation("VisitParticipantUser")
  checklistItems VisitChecklistItem[] @relation("ChecklistAssignee")
  documents      DocumentFile[]       @relation("DocumentUploader")
  ownedActivities   BusinessActivity[]    @relation("ActivityOwner")
  activityRoles     ActivityParticipant[] @relation("ActivityTeamMember")
  settings       SystemSetting[]      @relation("SettingEditor")

  @@index([departmentId])
  @@index([deletedAt])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  /// Ham token asla saklanmaz; yalnızca SHA-256 özeti.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Access token kara listesi (logout / zorla çıkış). jti bazlı.
model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  /// Değişiklik öncesi/sonrası özet (hassas alanlar maskelenir)
  changes    Json?
  ip         String?
  userAgent  String?
  statusCode Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Coğrafya
// ---------------------------------------------------------------------------

/// Hem Türkiye illerini hem uluslararası şehirleri tutar.
/// MKE yurt dışı pazarlarda da çalıştığı için şehir listesi ülkeye göre bölünür.
model City {
  id          String  @id @default(uuid())
  name        String
  /// ISO 3166-1 alpha-2 — TR, DE, AE, QA ...
  countryCode String  @default("TR")
  country     String  @default("Türkiye")
  /// Yalnızca Türkiye illerinde dolu; yurt dışı şehirlerde null.
  plateCode   Int?
  latitude    Float
  longitude   Float
  region      String?

  companies Company[]

  // Şehir adı küresel olarak benzersiz DEĞİLDİR (ör. Tripoli/LB ve Tripoli/LY).
  // Benzersizlik ülke ile birlikte tanımlanır.
  @@unique([countryCode, name])
  @@index([countryCode])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Şirket & kişi
// ---------------------------------------------------------------------------

model Company {
  id           String      @id @default(uuid())
  name         String
  type         CompanyType @default(B2B)
  status       String      @default("Potansiyel")
  sector       String?
  website      String?
  email        String?
  phone        String?
  taxNumber    String?
  taxOffice    String?
  address      String?
  country      String      @default("Türkiye")
  /// ISO 3166-1 alpha-2
  countryCode  String      @default("TR")
  cityId       String?
  /// Şehir listesinde bulunmayan (çoğunlukla yurt dışı) lokasyonlar için
  /// serbest metin. `cityId` doluysa görüntülemede o kaydın adı önceliklidir.
  cityName     String?
  districtName String?
  latitude     Float?
  longitude    Float?
  notes        String?
  ownerId      String?
  departmentId String?
  /// Dinamik özel alan verileri: {"fieldKey": value}
  customFields Json?

  isArchived Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  city       City?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  owner      User?       @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  contacts   Contact[]
  deals      Deal[]
  offers     Offer[]
  tenders    Tender[]
  contracts  Contract[]
  tasks      Task[]
  tickets    Ticket[]
  activities Activity[]
  emails     EmailQueue[]
  notes      Note[]
  visits     ProtocolVisit[]
  documents  DocumentFile[]
  businessActivities BusinessActivity[]
  tags               CompanyTag[]

  @@index([deletedAt])
  @@index([name])
  @@index([type, deletedAt])
  @@index([status])
  @@index([cityId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([countryCode])
  @@index([countryCode, type])
}

model Contact {
  id        String  @id @default(uuid())
  /// Şirket bağı ZORUNLU DEĞİLDİR. Bağımsız danışman, aracı, komisyoncu
  /// veya askeri ataşe hiçbir kuruma bağlı olmadan kaydedilebilir.
  companyId String?
  /// Kurum Çalışanı, Bağımsız Danışman, Aracı/Komisyoncu, Askeri Ataşe, Diğer
  contactType String @default("Kurum Çalışanı")
  firstName String
  lastName  String
  title     String?
  email     String?

  departmentName String?
  managerName    String?
  website        String?
  sector         String?
  avatarUrl      String?
  linkedinUrl    String?
  notes          String?

  /// Esnek doğum tarihi: yalnızca yıl veya yalnızca ay/gün girilebilir.
  birthYear  Int?
  birthMonth Int?
  birthDay   Int?

  // --- Bağımsız kişinin kendi adres/konum bilgisi ---
  // Kuruma bağlı kişilerde bu alanlar boş bırakılır; adres kurumdan gelir.
  addressLine String?
  cityName    String?
  country     String  @default("Türkiye")
  countryCode String  @default("TR")
  latitude    Float?
  longitude   Float?

  isPrimary Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phones  ContactPhone[]

  deals      Deal[]
  offers     Offer[]
  tasks      Task[]
  tickets    Ticket[]
  activities Activity[]
  emails     EmailQueue[]
  notes      Note[]
  visitRoles VisitParticipant[]

  activityLinks ActivityContact[]
  tags          ContactTag[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([lastName, firstName])
  @@index([email])
  @@index([birthMonth, birthDay])
  @@index([countryCode])
  @@index([contactType])
}

model ContactPhone {
  id     String @id @default(uuid())
  contactId String
  number String
  /// Boşluksuz/sembolsüz arama alanı (ör. 905321234567)
  normalizedNumber String
  label            String  @default("Cep")
  isPrimary        Boolean @default(false)
  isInactive       Boolean @default(false)
  inactiveReason   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([normalizedNumber])
}

// ---------------------------------------------------------------------------
// Satış süreci
// ---------------------------------------------------------------------------

model Deal {
  id        String @id @default(uuid())
  title     String
  companyId String
  contactId String?
  ownerId   String?

  stage    String  @default("Potansiyel")
  amount   Float   @default(0)
  /// Savunma sanayii satışlarının neredeyse tamamı dövizle yapılır;
  /// varsayılan USD. TRY/EUR listeden seçilebilir.
  currency String  @default("USD")
  /// Kayıt anındaki kur — YALNIZCA denetim/iz amaçlı saklanır.
  /// Fırsat değerlemesi listelerde ANLIK kurla yapılır (bkz. currency.service).
  /// `@map` ile mevcut sütun adı korunur: veri kaybı olmadan yeniden adlandırma.
  exchangeRateAtCreation Float? @map("exchangeRate")

  expectedCloseDate DateTime?
  description       String?
  customFields      Json?

  winProbabilityScore Int?
  lossReason          String?
  lossDetail          String?
  closedAt            DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  offers     Offer[]
  tasks      Task[]
  activities Activity[]
  notes      Note[]
  businessActivities BusinessActivity[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([stage, deletedAt])
  @@index([ownerId])
  @@index([expectedCloseDate])
  @@index([createdAt])
}

model Offer {
  id          String @id @default(uuid())
  offerNumber String @unique
  title       String
  companyId   String
  contactId   String?
  dealId      String?

  status   String @default("Taslak")
  currency String @default("USD")
  /// Teklif resmiyet kazandığında (Gönderildi/Kabul) dondurulan kur.
  /// Taslak tekliflerde değerleme anlık kurla yapılır.
  exchangeRateAtCreation Float? @map("exchangeRate")

  subtotal  Float @default(0)
  taxTotal  Float @default(0)
  total     Float @default(0)

  // --- Tahmini maliyet ve brüt marj ---
  /// Kalemlerin maliyetlerinin toplamı (costCurrency cinsinden).
  costTotal    Float  @default(0)
  /// Maliyet para birimi satış para biriminden farklı olabilir:
  /// hammadde USD alınıp teklif EUR verilebilir.
  costCurrency String @default("USD")

  /// Teslim şekli — Incoterms 2020 (EXW, FCA, FAS, FOB, CFR, CIF, CPT,
  /// CIP, DAP, DPU, DDP). Fiyatın neyi kapsadığını belirler.
  incoterm      String?
  /// Teslim yeri: "İstanbul Limanı", "Hamad Port, Doha"
  incotermPlace String?

  validUntil DateTime?
  notes      String?
  terms      String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal      Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items     OfferItem[]
  contracts Contract[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([status])
  @@index([dealId])
}

model OfferItem {
  id        String  @id @default(uuid())
  offerId   String
  productId String?

  name        String
  description String?
  quantity    Float  @default(1)
  unit        String @default("Adet")
  unitPrice   Float  @default(0)
  /// Birim başına tahmini maliyet (Offer.costCurrency cinsinden).
  /// Kalem maliyeti = cost * quantity.
  cost        Float  @default(0)
  taxRate     Float  @default(20.0)
  discountRate Float @default(0)
  lineTotal   Float  @default(0)
  sortOrder   Int    @default(0)

  offer   Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([productId])
}

model Tender {
  id           String @id @default(uuid())
  tenderNumber String @unique
  title        String
  companyId    String

  status   String @default("Takipte")
  method   String?
  currency String @default("TRY")
  /// Denetim izi; ihale değerlemesi anlık kurla yapılır.
  exchangeRateAtCreation Float? @map("exchangeRate")
  estimatedValue Float @default(0)

  submissionDeadline DateTime?
  announcementDate   DateTime?
  description        String?
  /// Şartname metni — AI risk analizinin girdisi
  specificationText  String?
  customFields       Json?

  winProbabilityScore Int?
  lossReason          String?
  lossDetail          String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts  Contract[]
  tasks      Task[]
  activities Activity[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([submissionDeadline])
}

model Contract {
  id             String @id @default(uuid())
  contractNumber String @unique
  title          String
  companyId      String
  offerId        String?
  tenderId       String?

  status   String @default("Aktif")
  amount   Float  @default(0)
  currency String @default("USD")
  /// Sözleşme/imza tarihindeki kur. Detayda "İmza tarihindeki değeri" ile
  /// "güncel piyasa değeri" birlikte gösterilir.
  exchangeRateAtCreation Float? @map("exchangeRate")

  startDate    DateTime?
  endDate      DateTime?
  renewalDate  DateTime?
  description  String?
  terms        String?

  // --- Termin (teslimat) takibi ---
  /// Yürürlükteki termin tarihi. Yetkili revize edebilir; her revizyonda
  /// deliveryRevisedAt güncellenir ve zaman tüneline kayıt düşer.
  deliveryDate      DateTime?
  /// İlk taahhüt edilen termin — gecikme ölçümü bu tarihe göre yapılır.
  originalDeliveryDate DateTime?
  deliveryRevisedAt DateTime?
  deliveryNote      String?
  /// Teslim edildi işaretlendiğinde dolar; hatırlatıcılar susar.
  deliveredAt       DateTime?

  // --- Gerçekleşen maliyet (COGS) ---
  /// Satılan malın maliyeti. Teklifteki tahmini maliyetin aksine
  /// sipariş kapandığında kesinleşen rakamdır.
  cogs         Float?
  cogsCurrency String  @default("USD")
  cogsNote     String?

  // --- Teslim şekli (Incoterms 2020) ---
  incoterm      String?
  incotermPlace String?

  // --- İhracat kontrolü (savunma sanayii) ---
  /// Son Kullanıcı Belgesi alındı mı? İhracat izninin ön şartıdır.
  eucStatus     String  @default("Gerekli Değil")
  /// EUC'yi düzenleyen resmî makam.
  eucAuthority  String?
  eucReference  String?
  eucReceivedAt DateTime?

  /// İhracat izni durumu: Gerekli Değil, Başvurulmadı, Başvuruldu,
  /// İnceleniyor, Onaylandı, Reddedildi, Süresi Doldu
  exportLicenceStatus    String  @default("Başvurulmadı")
  /// İzni veren makam: MSB, SSB, Dışişleri, Diğer
  exportLicenceAuthority String?
  exportLicenceNumber    String?
  exportLicenceAppliedAt DateTime?
  exportLicenceIssuedAt  DateTime?
  exportLicenceExpiresAt DateTime?
  exportLicenceNote      String?

  /// Sipariş için stok rezerve edildi mi?
  stockReserved Boolean @default(false)
  stockNote     String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offer      Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)
  tender     Tender?            @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  milestones PaymentMilestone[]
  activities Activity[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([status])
  @@index([endDate])
  @@index([renewalDate])
  @@index([deliveryDate])
  @@index([exportLicenceStatus])
  @@index([exportLicenceExpiresAt])
}

model PaymentMilestone {
  id         String   @id @default(uuid())
  contractId String
  title      String
  amount     Float
  currency   String   @default("TRY")
  /// Hakediş, bağlı olduğu sözleşmenin kur mantığını izler.
  exchangeRateAtCreation Float? @map("exchangeRate")
  dueDate    DateTime
  status     String   @default("Bekliyor")
  invoiceNumber String?
  paidAt     DateTime?
  note       String?
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status, dueDate])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Ürün / envanter
// ---------------------------------------------------------------------------

model Product {
  id            String  @id @default(uuid())
  sku           String  @unique
  name          String
  description   String?
  category      String
  unitPrice     Float   @default(0)
  currency      String  @default("USD")
  taxRate       Float   @default(20.0)
  stockQuantity Int     @default(0)
  minStockLevel Int     @default(0)
  unit          String  @default("Adet")
  isActive      Boolean @default(true)

  // --- Ambalaj / lojistik (koli-palet-konteyner hesabı için) ---
  /// Tek birimin net ağırlığı (kg)
  unitWeightKg   Float?
  /// Bir sandık/kolideki birim adedi
  caseQuantity   Int?
  caseLengthCm   Float?
  caseWidthCm    Float?
  caseHeightCm   Float?
  /// Dolu sandığın brüt ağırlığı (kg)
  caseWeightKg   Float?
  /// BM tehlike sınıfı (ör. "1.1D", "1.4S") — konteyner ve izin planını etkiler
  hazardClass    String?
  /// BM madde numarası (ör. "UN0012")
  unNumber       String?
  /// Net patlayıcı ağırlığı — birim başına gram. Sevkiyat izinlerinin
  /// ve konteyner limitlerinin dayanağıdır.
  neqGrams       Float?

  // --- Savunma sanayii sınıflandırması ---
  /// NATO Stok Numarası, 13 hane (ör. "1305-27-123-4567")
  nsn            String?
  /// Askeri Liste sınıflandırması (ör. "ML3" — mühimmat)
  militaryListCategory String?
  /// İhracat izni gerektiriyor mu? (MSB / SSB kontrolü)
  requiresExportLicence Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  offerItems OfferItem[]

  @@index([deletedAt])
  @@index([category])
  @@index([sku])
  @@index([name])
  @@index([nsn])
}

// ---------------------------------------------------------------------------
// Satış sonrası destek / garanti
// ---------------------------------------------------------------------------

model Ticket {
  id           String  @id @default(uuid())
  ticketNumber String  @unique
  title        String
  description  String
  priority     String  @default("Orta")
  status       String  @default("Açık")
  category     String
  companyId    String
  contactId    String?
  assignedUserId String?

  slaDeadline    DateTime?
  resolvedAt     DateTime?
  resolutionNote String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User?      @relation("TicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([companyId])
  @@index([deletedAt])
  @@index([status, priority])
  @@index([assignedUserId])
  @@index([slaDeadline])
}

// ---------------------------------------------------------------------------
// Görev, takvim, notlar
// ---------------------------------------------------------------------------

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  type        String  @default("Görev")
  priority    String  @default("Orta")
  status      String  @default("Açık")

  dueDate   DateTime?
  /// "09:30"
  startTime String?
  /// "11:00"
  endTime   String?
  isAllDay  Boolean @default(true)

  companyId      String?
  contactId      String?
  dealId         String?
  tenderId       String?
  assignedUserId String?

  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  tender       Tender?  @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([dueDate, status])
  @@index([assignedUserId, status])
  @@index([companyId])
}

model Note {
  id        String  @id @default(uuid())
  title     String?
  body      String  @default("")
  color     String  @default("#fef3c7")
  positionX Int     @default(0)
  positionY Int     @default(0)
  isPinned  Boolean @default(false)
  userId    String

  /// Zaman tünelinden eklenen notlar bir kuruma bağlanır; "Notlarım"
  /// ekranında kurum etiketiyle listelenir.
  companyId String?
  contactId String?
  dealId    String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Zaman tüneli (timeline) & e-posta
// ---------------------------------------------------------------------------

model Activity {
  id    String  @id @default(uuid())
  /// NOTE, CALL, EMAIL, WHATSAPP, STAGE_CHANGE, TASK, TICKET, SYSTEM
  type  String
  title String
  body  String?

  companyId  String?
  contactId  String?
  dealId     String?
  tenderId   String?
  contractId String?
  ticketId   String?
  userId     String?
  metadata   Json?

  createdAt DateTime @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tender   Tender?   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ticket   Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@index([createdAt])
}

model EmailQueue {
  id        String  @id @default(uuid())
  toAddress String
  ccAddress String?
  subject   String
  bodyHtml  String
  bodyText  String?
  /// QUEUED, SENT, FAILED — SMTP yokken simülatör doğrudan SENT yazar.
  status    String  @default("SENT")
  provider  String  @default("LOCAL_SIMULATOR")
  errorText String?

  companyId String?
  contactId String?
  userId    String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([companyId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Kur önbelleği & dinamik alanlar
// ---------------------------------------------------------------------------

model ExchangeRateCache {
  code      String   @id
  rate      Float
  /// TCMB | FALLBACK_ECB | MANUEL | SEED
  source    String   @default("TCMB")
  /// Kaynağın yayınladığı değerleme tarihi (çekim zamanından farklı olabilir:
  /// hafta sonu ve tatillerde TCMB bir önceki iş gününün kurunu yayınlar).
  rateDate  DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CustomFieldDefinition {
  id          String  @id @default(uuid())
  /// COMPANY, CONTACT, DEAL, TENDER
  entityType  String
  fieldKey    String
  fieldLabel  String
  /// TEXT, NUMBER, DATE, SELECT
  fieldType   String  @default("TEXT")
  /// SELECT için JSON dizi: ["A","B"]
  optionsJson String?
  isRequired  Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, fieldKey])
  @@index([entityType, isActive])
}

// ---------------------------------------------------------------------------
// Sistem ayarları (şifrelenmiş sırlar dahil)
// ---------------------------------------------------------------------------

/// Çalışma zamanında değiştirilebilen ayarlar. `isSecret` olan kayıtların
/// `value` alanı AES-256-GCM ile şifreli tutulur ve API'den ASLA düz metin
/// dönmez; yalnızca maskelenmiş önizleme verilir.
model SystemSetting {
  key         String   @id
  value       String
  isSecret    Boolean  @default(false)
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Protokol & heyet programı
// ---------------------------------------------------------------------------

/// Yabancı askerî ataşe ve delegasyon ziyaretleri.
model ProtocolVisit {
  id          String   @id @default(uuid())
  visitCode   String   @unique
  title       String
  /// ATAŞE_ZİYARETİ, DELEGASYON, FABRİKA_GEZİSİ, POLİGON_TESTİ, DİĞER
  visitType   String   @default("DELEGASYON")
  /// Planlandı, Onay Bekliyor, Devam Ediyor, Tamamlandı, İptal
  status      String   @default("Planlandı")
  /// Ziyaretçi heyetin ülkesi
  country     String
  countryCode String   @default("TR")
  companyId   String?

  startDate DateTime
  endDate   DateTime?
  location  String?
  /// Gizlilik derecesi: Tasnif Dışı, Hizmete Özel, Gizli
  classification String @default("Hizmete Özel")

  summary     String?
  /// Protokol sorumlusu (MKE tarafı)
  hostUserId  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company      Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  host         User?                @relation("VisitHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  agenda       VisitAgendaItem[]
  participants VisitParticipant[]
  checklist    VisitChecklistItem[]
  documents    DocumentFile[]

  @@index([deletedAt])
  @@index([startDate])
  @@index([status, startDate])
  @@index([countryCode])
}

/// Saat saat ziyaret akışı.
model VisitAgendaItem {
  id      String @id @default(uuid())
  visitId String

  /// Programın hangi gününe ait olduğu
  day       DateTime
  /// "09:30"
  startTime String
  endTime   String?
  title     String
  /// KARŞILAMA, BRİFİNG, FABRİKA_GEZİSİ, POLİGON_TESTİ, YEMEK, TRANSFER, DİĞER
  activityType String @default("DİĞER")
  location  String?
  /// Bu maddeden sorumlu MKE personeli (serbest metin — dış paydaş olabilir)
  responsible String?
  notes     String?
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit ProtocolVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, day, startTime])
}

/// Hem gelen misafir heyeti hem eşlik eden MKE personeli.
model VisitParticipant {
  id      String @id @default(uuid())
  visitId String

  /// MISAFIR (gelen heyet) veya EV_SAHIBI (eşlik eden MKE personeli)
  side      String  @default("MISAFIR")
  fullName  String
  title     String?
  rank      String?
  organization String?
  nationality  String?
  passportNo   String?
  email     String?
  phone     String?

  /// false ise katılımcı listede ÜSTÜ ÇİZİLİ gösterilir (kayıt silinmez:
  /// heyet listesi resmî bir belgedir, kimin gelmediği de bilgidir).
  isAttending   Boolean @default(true)
  absenceReason String?

  /// CRM'de kayıtlı bir kişiyle eşleşiyorsa bağlanır
  contactId String?
  /// MKE personeliyse kullanıcıya bağlanır
  userId    String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit   ProtocolVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user    User?         @relation("VisitParticipantUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitId, side])
}

/// Karşılama kontrol listesi.
model VisitChecklistItem {
  id      String @id @default(uuid())
  visitId String

  title    String
  /// HEDİYELİK, ARAÇ, YEMEK, GÜVENLİK, KONAKLAMA, SUNUM, DİĞER
  category String  @default("DİĞER")
  isDone   Boolean @default(false)
  dueDate  DateTime?
  assignedUserId String?
  note     String?
  sortOrder Int    @default(0)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visit        ProtocolVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  assignedUser User?         @relation("ChecklistAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([visitId, isDone])
}

// ---------------------------------------------------------------------------
// Kurumsal evrak ve pazarlama deposu
// ---------------------------------------------------------------------------

/// Hem belge deposu hem ziyaret ekleri aynı tabloyu kullanır; `visitId`
/// doluysa kayıt bir ziyaretin ekidir, boşsa kurumsal depoda durur.
///
/// İçerik veritabanında `Bytes` olarak tutulur. Ayrı bir nesne deposu
/// (S3/MinIO) bağlanana kadar bu, Docker'da ek hacim yapılandırması
/// gerektirmeyen en basit çalışan çözümdür; boyut sınırı uygulanır.
model DocumentFile {
  id       String @id @default(uuid())
  title    String
  fileName String
  mimeType String
  sizeBytes Int
  content  Bytes

  /// PAZAR_ANALIZI, ULKE_BRIFINGI, DIPLOMATIK_NOTA, PASAPORT_LISTESI,
  /// SUNUM, SOZLESME_ORNEGI, TEKNIK_DOKUMAN, DIGER
  category    String @default("DIGER")
  description String?
  /// Tasnif Dışı, Hizmete Özel, Gizli
  classification String @default("Hizmete Özel")
  /// Serbest etiketler: ["Katar", "2026", "mühimmat"]
  tags        Json?

  companyId  String?
  visitId    String?
  activityId String?
  uploadedById String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  visit      ProtocolVisit?    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  activity   BusinessActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploadedBy User?             @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([category])
  @@index([companyId])
  @@index([visitId])
  @@index([activityId])
  @@index([createdAt])
}

// ===========================================================================
// Aktivite havuzu — fuar, toplantı, saha ziyareti, fabrika gezisi
// ---------------------------------------------------------------------------
// Bu model, zaman tünelini besleyen `Activity` kaydından AYRIDIR.
// `Activity` otomatik üretilen bir olay günlüğüdür (not eklendi, aşama
// değişti...). `BusinessActivity` ise elle planlanan ve sonuçlandırılan
// ticari bir etkinliktir; hiçbir kuruma, kişiye veya fırsata bağlı olmak
// zorunda değildir. İkisini tek modelde birleştirmek zaman tünellerini
// planlama kayıtlarıyla kirletirdi.
// ===========================================================================

model BusinessActivity {
  id           String @id @default(uuid())
  activityCode String @unique
  title        String
  /// TOPLANTI, FUAR, SAHA_ZIYARETI, FABRIKA_GEZISI, DIGER
  type         String @default("TOPLANTI")
  /// Planlandı, Devam Ediyor, Tamamlandı, İptal
  status       String @default("Planlandı")

  startDate DateTime
  endDate   DateTime?

  /// Fuar/etkinlik yeri: "IDEF 2026, İstanbul" veya "DSEI, Londra"
  location    String?
  venue       String?
  country     String @default("Türkiye")
  countryCode String @default("TR")

  /// Planlama aşamasındaki amaç/hedef notu.
  objective String?
  /// Etkinlik sonrası genel değerlendirme.
  summary   String?

  // --- Fuar Sonuç Raporu ---
  /// Rapor özet değerlendirme notu. Dosyanın kendisi DocumentFile olarak
  /// bu aktiviteye yüklenir (kategori: FUAR_SONUC_RAPORU).
  outcomeNote     String?
  /// Rapor tamamlandığında dolar; "raporu bekleyen fuarlar" bu alanla bulunur.
  outcomeReportAt DateTime?
  /// Toplanan kartvizit adedi (elle girilir; sisteme işlenenler contacts'ta).
  leadCount       Int     @default(0)

  budgetAmount   Float?
  budgetCurrency String @default("USD")

  ownerId   String?
  companyId String?
  dealId    String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     User?                 @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company   Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  team      ActivityParticipant[]
  contacts  ActivityContact[]
  documents DocumentFile[]

  @@index([deletedAt])
  @@index([type, startDate])
  @@index([status, startDate])
  @@index([countryCode])
  @@index([startDate])
}

/// Etkinliğe katılan MKE personeli.
model ActivityParticipant {
  id         String @id @default(uuid())
  activityId String
  userId     String?
  /// Sistemde kullanıcısı olmayan katılımcı için serbest isim.
  fullName   String
  role       String?
  /// Katılım durumu: katılamayacağını bildiren kişi listeden SİLİNMEZ,
  /// üstü çizilir — kimin davet edildiği kaydın bir parçasıdır.
  isAttending Boolean @default(true)
  absenceReason String?
  sortOrder  Int     @default(0)

  activity BusinessActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User?            @relation("ActivityTeamMember", fields: [userId], references: [id], onDelete: SetNull)

  @@index([activityId])
}

/// Fuarda görüşülen kişi / toplanan kartvizit.
/// Kişi kaydı bağımsız olabilir (Contact.companyId null) — fuarda tanışılan
/// bir ataşenin kurumu genellikle sistemde yoktur.
model ActivityContact {
  id         String @id @default(uuid())
  activityId String
  contactId  String

  /// Görüşme notu: "155mm ile ilgilendi, numune talep etti"
  note        String?
  /// Sıcaklık: Sıcak, Ilık, Soğuk
  interest    String  @default("Ilık")
  /// Takip edildi mi?
  followedUp  Boolean @default(false)
  createdAt   DateTime @default(now())

  activity BusinessActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([activityId, contactId])
  @@index([activityId])
  @@index([contactId])
}

// ===========================================================================
// Etiketler
// ---------------------------------------------------------------------------
// Etiketler daha önce `customFields` JSON alanının içinde serbest metin
// olarak duruyordu. Bu yüzden "bu etikete sahip kayıtlar" sorgusu yazılamıyor,
// etiket yeniden adlandırılamıyor ve bir kayıttan merkezî olarak
// kaldırılamıyordu. İlişkisel model bunların üçünü de tek sorguyla çözer.
// ===========================================================================

model Tag {
  id          String  @id @default(uuid())
  name        String  @unique
  /// Rozet rengi (hex). Varsayılan kurumsal bronz.
  color       String  @default("#C5A059")
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies CompanyTag[]
  contacts  ContactTag[]

  @@index([name])
}

model CompanyTag {
  companyId String
  tagId     String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([tagId])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}
