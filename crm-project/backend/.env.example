# --- Veritabanı ---
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# --- Sunucu ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- JWT ---
# Üretimde MUTLAKA 32+ karakterlik rastgele değerlerle değiştirin.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Çöp kutusu / arka plan işleri ---
TRASH_RETENTION_DAYS=30
ENABLE_BACKGROUND_JOBS=true

# --- TCMB kur senkronizasyonu ---
TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml

# --- AI (opsiyonel; anahtar yoksa yerel kural tabanlı motor devreye girer) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
