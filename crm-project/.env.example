# docker compose için ortam değişkenleri.
# Üretimde JWT sırlarını `openssl rand -base64 48` ile üretin.

POSTGRES_PASSWORD=degistirin-guclu-bir-parola
JWT_ACCESS_SECRET=en-az-32-karakterlik-rastgele-access-sirri
JWT_REFRESH_SECRET=en-az-32-karakterlik-rastgele-refresh-sirri
CORS_ORIGIN=http://localhost:8080

# Opsiyonel: tanımsızsa AI modülü yerel motorla çalışır, veri dışarı çıkmaz.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
